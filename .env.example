# ── Public (safe to expose to the browser) ─────────────────────────
# Supabase project URL and anon (publishable) key — Supabase dashboard › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Canonical public URL of the site. Encoded in the common event QR code (…/verify).
NEXT_PUBLIC_SITE_URL=https://sraneel-sd.vercel.app

# ── Server only (never prefix with NEXT_PUBLIC_) ──────────────────
# Service-role key. Used only inside Route Handlers for registration, verification and rate limiting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Random secret (32+ chars) used to hash IP addresses for rate limiting / abuse logs.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
